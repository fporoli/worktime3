# --- Shared edge stack secrets (copy to /opt/edge/.env on the VPS; never commit real values) ---
# Same rule as worktime3's compose/vps.env.example: docker compose loads `.env` from the
# directory containing the compose file, so this belongs at /opt/edge/.env.
#
# Bootstrap superuser for the shared Postgres server (see the pg service in
# docker-compose.yml) — not embedded in any URL by this stack itself, but generate with
# `openssl rand -hex 32` anyway (hex only) so it's safe if something ever does.
EDGE_PG_ADMIN_PASSWORD=change-me
