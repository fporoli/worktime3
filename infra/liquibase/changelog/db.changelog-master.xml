<?xml version="1.0" encoding="UTF-8"?>
<!--
  Master changelog: lists every changelog file in the order it must apply.
  Kept as a thin XML index — the actual changes are all plain SQL below.
  ("include"/"includeAll" from inside a *SQL-formatted* root changelog is a
  Liquibase Secure-only feature; an XML/YAML/JSON root including SQL files
  is the open-source-supported way to do this.)

  To make a schema change: add a new numbered file here (e.g.
  003-my-change.sql), add its <include> line at the bottom, then run
  `npm run db:migrate` and `npm run db:introspect` (see README).
-->
