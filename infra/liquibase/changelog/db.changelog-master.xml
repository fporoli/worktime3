<?xml version="1.0" encoding="UTF-8"?>
<!--
  Master changelog: lists every changelog file in the order it must apply.
  Kept as a thin XML index — the actual changes are all plain SQL below.
  ("include"/"includeAll" from inside a *SQL-formatted* root changelog is a
  Liquibase Secure-only feature; an XML/YAML/JSON root including SQL files
  is the open-source-supported way to do this.)

  To make a schema change: add a new numbered file here (e.g.
  003-my-change.sql), add its <include> line at the bottom, then run
  `npm run db:migrate` and `npm run db:introspect` (see README).
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="001-initial-schema.sql" relativeToChangelogFile="true"/>
    <include file="002-worktime-extensions.sql" relativeToChangelogFile="true"/>
    <include file="003-timesheet-periods.sql" relativeToChangelogFile="true"/>
    <include file="004-member-rates.sql" relativeToChangelogFile="true"/>
    <include file="005-worktime-cleanup.sql" relativeToChangelogFile="true"/>
    <include file="006-fold-org-settings-and-sso.sql" relativeToChangelogFile="true"/>
    <include file="007-role-multiplicity.sql" relativeToChangelogFile="true"/>
    <include file="008-team-lead.sql" relativeToChangelogFile="true"/>
    <include file="009-drop-team-member-manager.sql" relativeToChangelogFile="true"/>
    <include file="010-membership-manager-and-settings.sql" relativeToChangelogFile="true"/>
    <include file="011-static-data-organization-scoped.sql" relativeToChangelogFile="true"/>
    <include file="012-versions.sql" relativeToChangelogFile="true"/>
    <include file="013-versions-rename-columns.sql" relativeToChangelogFile="true"/>
    <include file="014-versions-rename-workflow-column.sql" relativeToChangelogFile="true"/>
    <include file="015-workflows.sql" relativeToChangelogFile="true"/>
    <include file="016-drop-created-updated-columns.sql" relativeToChangelogFile="true"/>
    <include file="017-index-worktimes-org-start.sql" relativeToChangelogFile="true"/>
    <include file="018-workflow-steps.sql" relativeToChangelogFile="true"/>
    <include file="019-revert-workflow-steps.sql" relativeToChangelogFile="true"/>
    <include file="020-expenses.sql" relativeToChangelogFile="true"/>
    <include file="021-expenses-value.sql" relativeToChangelogFile="true"/>
    <include file="022-notifications.sql" relativeToChangelogFile="true"/>
    <include file="023-expenses-original-nullable.sql" relativeToChangelogFile="true"/>

</databaseChangeLog>

