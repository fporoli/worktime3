{
  "version": "0.2.0",
  "configurations": [    
    {
      "type": "node",
      "request": "launch",
      "name": "Development API: Debug",
      "cwd": "${workspaceFolder}/apps/api",
      "program": "${workspaceFolder}/apps/api/dist/main.js",
      "envFile": "${workspaceFolder}/.env.dev",
      "preLaunchTask": "api: build",
      "outFiles": ["${workspaceFolder}/apps/api/dist/**/*.js"],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Development Web: Launch Chrome",
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}/apps/web",
      "preLaunchTask": "web: dev server",
      "sourceMaps": true
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Local Full Stack: Docker + Chrome",
      "url": "http://localhost:3002",
      "webRoot": "${workspaceFolder}/apps/web",
      "preLaunchTask": "local: stack up"
    }
  ],
  "compounds": [
    {
      "name": "Development Full Stack: API + Web",
      "configurations": ["Development API: Debug", "Development Web: Launch Chrome"],
      "stopAll": true
    }
  ]
}
