{
  "version": "0.2.0",
  "configurations": [
    
    {
      "type": "node",
      "request": "launch",
      "name": "Local API: Debug",
      "cwd": "${workspaceFolder}/apps/api",
      "program": "${workspaceFolder}/apps/api/dist/main.js",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "api: build",
      "outFiles": ["${workspaceFolder}/apps/api/dist/**/*.js"],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Local Web: Launch Chrome",
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}/apps/web",
      "preLaunchTask": "web: dev server",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "LocDev API: Debug",
      "cwd": "${workspaceFolder}/apps/api",
      "program": "${workspaceFolder}/apps/api/dist/main.js",
      "envFile": "${workspaceFolder}/.env.local",
      "preLaunchTask": "api: build",
      "outFiles": ["${workspaceFolder}/apps/api/dist/**/*.js"],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "LocDev Web: Launch Chrome",
      "url": "http://localhost:3002",
      "webRoot": "${workspaceFolder}/apps/web",
      "preLaunchTask": "web: dev server",
      "sourceMaps": true
    },
  ],
  "compounds": [
    {
      "name": "Local Full Stack: API + Web",    
      "configurations": ["Local API: Debug", "Local Web: Launch Chrome"],
      "stopAll": true
    },
    {
      "name": "Local Development Full Stack: API + Web",
      "configurations": ["LocDev API: Debug", "LocDev Web: Launch Chrome"],
      "stopAll": true
    }
  ]
}
