{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: build",
      "type": "shell",
      "command": "npm run build --workspace=@worktime3/api",
      "problemMatcher": [
        "$tsc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "dependsOn": [
        "dev: services up"
      ]
    },
    {
      "label": "web: dev server",
      "type": "shell",
      "command": "npm run dev --workspace=@worktime3/web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "local: stack up",
      "type": "shell",
      "command": "npm run local:up",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local"
      }
    },
    {
      "label": "local: stack down",
      "type": "shell",
      "command": "npm run local:down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local"
      }
    },
    {
      "label": "dev: services up",
      "type": "shell",
      "command": "npm run dev:up",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "dev: services down",
      "type": "shell",
      "command": "npm run dev:down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    }
  ]
}
