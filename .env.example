# --- public examples (copy to .env.local etc; never commit real secrets) ---
# ENV_NUMBER selects the port offsets: 8090+N keycloak, 5430+N pg, 3000+N web, 8000+N api
ENV_NUMBER=1
POSTGRES_DB=worktime
POSTGRES_USER=worktime
POSTGRES_PASSWORD=worktime_dev_only
DATABASE_URL=postgresql://worktime:worktime_dev_only@localhost:5431/worktime
# Backend uses the `public` schema; Keycloak uses the `auth` schema of the SAME database.
KC_DB_SCHEMA=auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_REALM=worktime
# Azure Entra ID (optional, link/unlink supported in API + UI)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
API_PORT=8001
WEB_PORT=3001
KC_PORT=8091
PG_PORT=5431
JWT_ISSUER=http://localhost:8091/realms/worktime
