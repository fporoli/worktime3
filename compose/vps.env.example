# --- VPS deploy secrets (copy to /opt/worktime3/.env on the VPS; never commit real values) ---
# docker compose auto-loads a `.env` file from its working directory — deploy-vps.yml's SSH
# script runs `cd /opt/worktime3 && docker compose -f compose/docker-compose.vps.yml up ...`,
# so this file belongs at /opt/worktime3/.env on the server, not in the compose/ directory.
#
# Generate real random values for the three secrets below — e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
API_JWT_SECRET=

# Outgoing mail — optional. Unset SMTP_HOST leaves sends failing silently (fire-and-forget,
# never breaks a request) until these are provided; nodemailer negotiates STARTTLS/AUTH itself.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=worktime@turbotapir.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
