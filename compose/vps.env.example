# --- VPS deploy secrets (copy to /opt/worktime3/compose/.env on the VPS; never commit real values) ---
# docker compose auto-loads a `.env` file from the directory containing the compose file passed
# via -f, not from the working directory the command is run from — so even though deploy-vps.yml's
# SSH script runs `cd /opt/worktime3 && docker compose -f compose/docker-compose.vps.yml up ...`,
# this file must live at /opt/worktime3/compose/.env, next to docker-compose.vps.yml.
#
# Generate real random values for the three secrets below.
#
# POSTGRES_PASSWORD gets embedded directly into the api service's DATABASE_URL as a
# connection-string URI (postgresql://worktime:<password>@pg:5432/worktime) — it is NOT
# percent-encoded, so a password containing `/`, `@`, `:`, `?`, `#`, etc. breaks URL
# parsing outright. Use `openssl rand -hex 32` (hex only, always URL-safe) for this one,
# not -base64 (which can produce `/`, `+`, `=`).
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD and API_JWT_SECRET aren't URL-embedded, so -base64 is fine here.
KEYCLOAK_ADMIN_PASSWORD=change-me
API_JWT_SECRET=

# Outgoing mail — optional. Left unset, docker-compose.vps.yml defaults to the shared
# Mailpit catcher on the edge network (view caught mail at https://mail.turbotapir.com);
# set these to point at a real relay instead. nodemailer negotiates STARTTLS/AUTH itself.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=worktime@turbotapir.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
