{
  "name": "worktime3",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise + individual time tracking (NestJS + React + Postgres + Keycloak + Caddy)",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "node infra/liquibase/migrate.mjs",
    "db:seed": "node infra/postgres/run-seed.mjs infra/postgres/seeds/seed.dev.sql",
    "db:testseed": "node infra/postgres/run-seed.mjs infra/postgres/seeds/seed.test.sql",
    "db:introspect": "npm run db:introspect --workspace=@worktime3/api"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/websockets": "12.2.0",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.15.18": true,
    "esbuild@0.28.2": true,
    "es5-ext": false
  }
}
